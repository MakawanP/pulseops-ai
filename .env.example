# PulseOps AI Configuration (Optional)
# The application runs 100% offline with zero API keys using the Local Grounded Tool Engine.
# Copy to .env (automatically loaded on startup; existing shell environment variables take precedence).
# Supply any provider key below to enable live LLM executive synthesis over verified SQL tool outputs.

PULSEOPS_DB_PATH=data/pulseops.db
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional LLM model overrides
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
